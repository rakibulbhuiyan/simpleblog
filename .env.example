# Port the Express API listens on
PORT=5000

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/simpleblog?schema=public"

# Secret used to sign login sessions — use a long random string
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: public URL used in RSS / sitemap links (defaults to the request host)
# SITE_URL="https://your-blog.com"

# Optional: max PostgreSQL connections in the pool (default 10)
# DATABASE_POOL_SIZE=10
